{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "helpers:pinGitCommits"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"]
  },
  "go": {
    "enabled": true
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "npm": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchDatasources": ["go"],
      "extends": ["schedule:weekly"]
    }
  ],
  "ignoreDeps": [
    "golang",
    "golang.org/x/vuln/cmd/govulncheck"
  ]
}
